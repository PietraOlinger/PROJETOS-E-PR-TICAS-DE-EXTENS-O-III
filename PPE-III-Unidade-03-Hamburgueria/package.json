{
  "name": "ppe-iii-unidade-03-hamburgueria",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "npm --prefix backend test",
    "test:frontend": "npm --prefix frontend test -- --run",
    "coverage": "npm run coverage:backend && npm run coverage:frontend",
    "coverage:backend": "npm --prefix backend run test:coverage",
    "coverage:frontend": "npm --prefix frontend run test:coverage",
    "build": "npm --prefix frontend run build",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend"
  }
}
